# Copy outside version control to a protected pilot-host configuration file.
# Every REPLACE_WITH_* value must be replaced. Never commit the populated file.

APP_ENVIRONMENT=pilot
STORAGE_BACKEND=postgresql
RELEASE_IDENTIFIER=product-milestone-9-candidate
RELEASE_GIT_COMMIT=REPLACE_WITH_40_HEX_COMMIT
RELEASE_GIT_TAG=product-milestone-9
RELEASE_ALEMBIC_REVISION=20260726_0008
PILOT_APP_IMAGE=ai-maintenance-copilot:product-milestone-9
PILOT_FRONTEND_IMAGE=ai-maintenance-copilot-frontend:product-milestone-9
PILOT_HOST_IDENTIFIER=REPLACE_WITH_APPROVED_OPAQUE_HOST_ID
PILOT_HOST_APPROVED=false

POSTGRES_USER=REPLACE_WITH_PILOT_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=REPLACE_WITH_PILOT_DATABASE_NAME
DATABASE_URL=postgresql+psycopg://REPLACE_WITH_PILOT_DATABASE_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/REPLACE_WITH_PILOT_DATABASE_NAME

TOKEN_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOKEN_SIGNING_PREVIOUS_SECRET=
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_SESSION_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=maintenance_refresh
CSRF_COOKIE_NAME=maintenance_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

PILOT_API_BIND_ADDRESS=127.0.0.1
PILOT_API_PORT=8000
PILOT_FRONTEND_BIND_ADDRESS=127.0.0.1
PILOT_FRONTEND_PORT=3000
PILOT_POSTGRES_BIND_ADDRESS=127.0.0.1
PILOT_POSTGRES_PORT=5432
PILOT_QDRANT_BIND_ADDRESS=127.0.0.1
PILOT_QDRANT_PORT=6333
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PILOT_API_HOST
FRONTEND_BASE_URL=https://REPLACE_WITH_PILOT_FRONTEND_HOST
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_PILOT_FRONTEND_HOST
TRUSTED_HOSTS=REPLACE_WITH_PILOT_API_HOST

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=maintenance_knowledge
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_ROOT=/app/data/attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
ANALYTICS_SOURCE_DIR=/app/data/raw
ANALYTICS_PROCESSED_DIR=/app/data/processed
LOG_LEVEL=INFO
# Pre-create attachments, analytics-input, and analytics-output below this root.
# The root and backup root must be absolute, outside the repository, and distinct.
PILOT_ALLOWED_DATA_ROOT=REPLACE_WITH_ABSOLUTE_PILOT_DATA_ROOT
PILOT_BACKUP_ROOT=REPLACE_WITH_ABSOLUTE_PILOT_BACKUP_ROOT
PILOT_BACKUP_RETENTION_COUNT=7

DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_LOCK_TIMEOUT_SECONDS=5
DATABASE_IDLE_TRANSACTION_TIMEOUT_SECONDS=60

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=60
WORKER_OUTBOX_LEASE_SECONDS=120
WORKER_BATCH_SIZE=20

OPERATIONAL_OUTBOX_AGE_ALERT_SECONDS=300
OPERATIONAL_REPEATED_JOB_FAILURE_THRESHOLD=3
OPERATIONAL_ANALYTICS_STALE_SECONDS=172800
OPERATIONAL_BACKUP_OVERDUE_SECONDS=604800
OPERATIONAL_DISK_WARNING_FREE_PERCENT=20
OPERATIONAL_DISK_CRITICAL_FREE_PERCENT=10
