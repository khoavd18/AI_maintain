	measure Tickets = SUM('Ticket SLA'[ticket_count])
		formatString: #,0
		description: Tổng ticket.
		lineageTag: 607cfe3b-9012-5147-9214-7e13f01e48fa

	measure 'Unresolved Tickets' = SUM('Ticket SLA'[unresolved_ticket_count])
		formatString: #,0
		description: Tổng ticket chưa resolved.
		lineageTag: 1eb4ed58-67f4-59f7-b84f-93f8a3f72dfa

	measure 'SLA Breaches' = SUM('Ticket SLA'[resolution_breach_count])
		formatString: #,0
		description: Tổng ticket breach resolution SLA.
		lineageTag: a595d1fc-8606-53bd-aad2-1bee83a974ce

	measure 'SLA Breach Rate' = DIVIDE([SLA Breaches], [Tickets])
		formatString: 0.0%
		description: Tỷ lệ breach resolution SLA.
		lineageTag: d6b33675-83ec-5cb6-b8c2-e999230183ad

	measure 'Escalated Tickets' = SUM('Ticket SLA'[escalated_ticket_count])
		formatString: #,0
		description: Tổng ticket đã escalation.
		lineageTag: ec261045-32d6-5ef5-a27f-0e883d2bbaf7

	measure 'First Response Met Rate' = DIVIDE(SUM('Ticket SLA'[first_response_met_count]), [Tickets])
		formatString: 0.0%
		description: Tỷ lệ đáp ứng first-response SLA.
		lineageTag: 1affe304-4e5e-5206-aeb3-b403768cc37f

	partition 'Ticket SLA' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("127.0.0.1:25432", "maintenance_copilot_benchmark_scale", [CreateNavigationProperties=false]),
				Data = Source{[Schema="analytics_marts", Item="ticket_sla"]}[Data],
				SelectedColumns = Table.SelectColumns(Data, {"site_id", "priority", "ticket_count", "unresolved_ticket_count", "first_response_met_count", "resolution_breach_count", "escalated_ticket_count"})
			in
				SelectedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
