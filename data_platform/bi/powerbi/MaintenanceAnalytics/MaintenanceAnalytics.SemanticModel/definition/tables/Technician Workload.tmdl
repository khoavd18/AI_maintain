	measure 'Assigned Technician Work Orders' = SUM('Technician Workload'[assigned_work_orders])
		formatString: #,0
		description: Tổng work order đã gán cho technician.
		lineageTag: b451f72f-fa77-5708-b1c0-808f24b783db

	measure 'Completed Technician Work Orders' = SUM('Technician Workload'[completed_work_orders])
		formatString: #,0
		description: Tổng work order completed hoặc verified theo technician.
		lineageTag: 40dbe61e-90a7-50dd-b553-1837693a62f9

	measure 'In-Progress Technician Work Orders' = SUM('Technician Workload'[in_progress_work_orders])
		formatString: #,0
		description: Tổng work order đang in progress theo technician.
		lineageTag: b59c70e5-fe7c-59c2-837a-9c3309c76f2c

	measure 'On-Hold Technician Work Orders' = SUM('Technician Workload'[on_hold_work_orders])
		formatString: #,0
		description: Tổng work order on-hold theo technician.
		lineageTag: aeaca9f6-630d-5910-a938-870dfe1c6c9a

	measure 'Technician Completion Rate' = DIVIDE([Completed Technician Work Orders], [Assigned Technician Work Orders])
		formatString: 0.0%
		description: Tỷ lệ completed trên assigned theo technician.
		lineageTag: 60ace64b-7963-59dc-8364-64e2cbd4fe8b

	partition 'Technician Workload' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("127.0.0.1:25432", "maintenance_copilot_benchmark_scale", [CreateNavigationProperties=false]),
				Sql = Text.Combine({
					"select",
					"    t.technician_id::text as technician_id,",
					"    w.site_id::text as site_id,",
					"    t.employee_code,",
					"    t.display_name,",
					"    t.role,",
					"    t.is_active,",
					"    count(w.work_order_id)::bigint as assigned_work_orders,",
					"    count(w.work_order_id) filter (",
					"        where w.status in ('completed', 'verified')",
					"    )::bigint as completed_work_orders,",
					"    count(w.work_order_id) filter (",
					"        where w.status = 'in_progress'",
					"    )::bigint as in_progress_work_orders,",
					"    count(w.work_order_id) filter (",
					"        where w.status = 'on_hold'",
					"    )::bigint as on_hold_work_orders",
					"from analytics_warehouse.dim_technician as t",
					"left join analytics_warehouse.fact_work_order as w",
					"    on w.assigned_technician_id = t.technician_id",
					"where t.technician_id <> '00000000-0000-0000-0000-000000000000'::uuid",
					"group by",
					"    t.technician_id,",
					"    w.site_id,",
					"    t.employee_code,",
					"    t.display_name,",
					"    t.role,",
					"    t.is_active"
				}, "#(lf)"),
				Data = Value.NativeQuery(Source, Sql, null, [EnableFolding=true])
			in
				Data

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
