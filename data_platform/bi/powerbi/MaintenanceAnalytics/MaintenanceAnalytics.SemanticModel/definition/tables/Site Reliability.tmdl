	measure 'Reliability Work Orders' = SUM('Site Reliability'[work_order_count])
		formatString: #,0
		description: Tổng work order trong mart reliability.
		lineageTag: 43f853d0-674d-5dd6-9d1c-22b251235f21

	measure 'Site Completed Work Orders' = SUM('Site Reliability'[completed_work_order_count])
		formatString: #,0
		description: Tổng work order hoàn thành trong mart reliability.
		lineageTag: 199446d1-0e48-5918-8a34-e9f0c37272a1

	measure 'Site Completion Rate' = DIVIDE([Site Completed Work Orders], [Reliability Work Orders])
		formatString: 0.0%
		description: Tỷ lệ hoàn thành tại các site được lọc.
		lineageTag: 01391584-4b6c-5c56-aae9-fb1c8cf44c07

	measure 'Site Average Repair Hours' = AVERAGE('Site Reliability'[average_repair_hours])
		formatString: 0.00
		description: Trung bình repair hours giữa các site có dữ liệu.
		lineageTag: faabbfb9-4deb-5631-9ce8-8e48cfeb650a

	measure 'On-Hold Hours' = DIVIDE(SUM('Site Reliability'[on_hold_seconds]), 3600)
		formatString: #,0.0
		description: Tổng thời gian on-hold quy đổi sang giờ.
		lineageTag: cf69411e-22ad-57e7-bf2c-e867df27ca67

	partition 'Site Reliability' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("127.0.0.1:25432", "maintenance_copilot_benchmark_scale", [CreateNavigationProperties=false]),
				Data = Source{[Schema="analytics_marts", Item="site_reliability"]}[Data],
				SelectedColumns = Table.SelectColumns(Data, {"site_id", "work_order_count", "completed_work_order_count", "cancelled_work_order_count", "average_repair_hours", "status_event_count", "observed_status_seconds", "on_hold_seconds"})
			in
				SelectedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
