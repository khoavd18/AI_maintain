	measure 'Total Work Orders' = SUM('Daily Work Orders'[total_work_orders])
		formatString: #,0
		description: Tổng work order trong phạm vi lọc.
		lineageTag: da964dda-4188-5139-994d-8475860bb27b

	measure 'Completed Work Orders' = SUM('Daily Work Orders'[completed_work_orders])
		formatString: #,0
		description: Tổng work order completed hoặc verified.
		lineageTag: 05fff6f4-112e-5c88-9154-682f4ec64b9e

	measure 'Completion Rate' = DIVIDE([Completed Work Orders], [Total Work Orders])
		formatString: 0.0%
		description: Tỷ lệ work order đã hoàn thành.
		lineageTag: 0fea8f87-5dde-5a85-820d-068c6ecbe64d

	measure 'Critical Work Orders' = SUM('Daily Work Orders'[critical_work_orders])
		formatString: #,0
		description: Tổng work order priority critical.
		lineageTag: f3a9838b-ce50-5983-968b-e60e54421b9d

	measure 'Unassigned Work Orders' = SUM('Daily Work Orders'[unassigned_work_orders])
		formatString: #,0
		description: Tổng work order chưa phân công.
		lineageTag: b79cb6fe-5d24-5232-abdc-448cad50822e

	measure 'Average Repair Hours' = DIVIDE(SUM('Daily Work Orders'[total_repair_hours]), SUM('Daily Work Orders'[repair_duration_work_orders]))
		formatString: 0.00
		description: Số giờ sửa chữa trung bình trên work order có duration.
		lineageTag: 49ebce73-6faa-5cd4-a19a-53660f669d07

	partition 'Daily Work Orders' = m
