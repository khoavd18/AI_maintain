APP_NAME=AI Maintenance Copilot
APP_ENVIRONMENT=development
RELEASE_IDENTIFIER=development
RELEASE_GIT_COMMIT=unverified
RELEASE_GIT_TAG=unverified
RELEASE_ALEMBIC_REVISION=20260726_0008
API_HOST_PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Leave empty only for development/test, where an ephemeral process secret is used.
# Pilot/production must inject a random value of at least 32 characters.
TOKEN_SIGNING_SECRET=
# Optional only during a bounded access-token rotation grace period.
TOKEN_SIGNING_PREVIOUS_SECRET=
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_SESSION_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=maintenance_refresh
CSRF_COOKIE_NAME=maintenance_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
COPILOT_RATE_LIMIT_REQUESTS=20
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60

# Local pilot attachment storage. File bodies stay outside PostgreSQL.
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_ROOT=data/attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Durable PM7 worker. PostgreSQL remains the queue and idempotency authority.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=60
WORKER_OUTBOX_LEASE_SECONDS=120
WORKER_BATCH_SIZE=20
OPERATIONAL_OUTBOX_AGE_ALERT_SECONDS=300
OPERATIONAL_REPEATED_JOB_FAILURE_THRESHOLD=3
OPERATIONAL_ANALYTICS_STALE_SECONDS=172800
OPERATIONAL_BACKUP_OVERDUE_SECONDS=604800
OPERATIONAL_DISK_WARNING_FREE_PERCENT=20
OPERATIONAL_DISK_CRITICAL_FREE_PERCENT=10
ANALYTICS_SOURCE_DIR=data/raw
ANALYTICS_PROCESSED_DIR=data/processed

# PostgreSQL is the normal transactional product mode.
STORAGE_BACKEND=postgresql
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_random_database_password
POSTGRES_DB=replace_with_database_name
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://replace_with_database_user:replace_with_random_database_password@localhost:5432/replace_with_database_name
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_LOCK_TIMEOUT_SECONDS=5
DATABASE_IDLE_TRANSACTION_TIMEOUT_SECONDS=60

# Tests refuse any database whose name does not end with _test.
TEST_DATABASE_URL=postgresql+psycopg://replace_with_database_user:replace_with_random_database_password@localhost:5432/replace_with_database_name_test

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintenance_knowledge
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
QDRANT_HTTP_PORT=6333

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=80
RAG_DENSE_CANDIDATES=20
RAG_SPARSE_CANDIDATES=20
RAG_FUSED_CANDIDATES=20
RAG_FINAL_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.55
RAG_DENSE_WEIGHT=0.50
RAG_SPARSE_WEIGHT=0.50
RAG_RETRIEVAL_WEIGHT=0.55
RAG_RERANKER_WEIGHT=0.40
RAG_METADATA_WEIGHT=0.05
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKER_DEVICE=auto
RAG_SPARSE_MAX_CHUNKS=10000
RAG_DEBUG_ENABLED=false

# Grounded generation is enabled for the local Docker demo. Start Ollama on the
# host before Compose; Docker reaches it through host.docker.internal.
# OpenAI-compatible example: https://provider.example/v1
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=1
LLM_MAX_CONTEXT_CHARS=12000
LLM_MIN_RELEVANT_DOCUMENTS=1

# Stage 9 isolated Data Platform. These local-only defaults never target the
# normal developer database; the runtime also requires a database ending in _scale.
DATA_PLATFORM_DB_HOST=127.0.0.1
DATA_PLATFORM_DB_PORT=25432
DATA_PLATFORM_DB_NAME=maintenance_copilot_scale
DATA_PLATFORM_DB_USER=maintenance_scale
DATA_PLATFORM_DB_PASSWORD=maintenance_scale_local_only
DATA_PLATFORM_DB_SCHEMA=analytics
DATA_PLATFORM_DB_SSLMODE=disable
DATA_PLATFORM_CONNECT_TIMEOUT_SECONDS=10
DATA_PLATFORM_STATEMENT_TIMEOUT_SECONDS=1800
DATA_PLATFORM_BATCH_SIZE=50000
DATA_PLATFORM_DATA_ROOT=data/scale
DATA_PLATFORM_OBJECT_STORE=local
# Optional and disabled for Stage 9. Never required for the local benchmark.
DATA_PLATFORM_S3_BUCKET=
STAGE9_AIRFLOW_API_PORT=18081
