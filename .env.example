APP_NAME=AI Maintenance Copilot
APP_ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Leave empty only for development/test, where an ephemeral process secret is used.
# Pilot/production must inject a random value of at least 32 characters.
TOKEN_SIGNING_SECRET=
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_SESSION_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=maintenance_refresh
CSRF_COOKIE_NAME=maintenance_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Local pilot attachment storage. File bodies stay outside PostgreSQL.
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_ROOT=data/attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Durable PM7 worker. PostgreSQL remains the queue and idempotency authority.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=60
WORKER_OUTBOX_LEASE_SECONDS=120
WORKER_BATCH_SIZE=20
ANALYTICS_SOURCE_DIR=data/raw
ANALYTICS_PROCESSED_DIR=data/processed

# PostgreSQL is the normal transactional product mode.
STORAGE_BACKEND=postgresql
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
POSTGRES_DB=maintenance_copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://maintenance:maintenance@localhost:5432/maintenance_copilot
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Tests refuse any database whose name does not end with _test.
TEST_DATABASE_URL=postgresql+psycopg://maintenance:maintenance@localhost:5432/maintenance_copilot_test

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintenance_knowledge
QDRANT_HTTP_PORT=6333


EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
